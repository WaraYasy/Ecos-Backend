# ==================================================================
# .dockerignore — contexto de build Docker para ecos-backend
# Rutas relativas al directorio ecos-backend/ (donde está el Dockerfile)
# ==================================================================

# ── Build output — se genera dentro del contenedor ───────────────
target/

# ── Entorno local ─────────────────────────────────────────────────
.env
logs/
*.log

# ── Git e IDE ─────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.idea/
*.iml
*.iws
*.ipr
.vscode/
.claude/

# ── Maven wrapper (se ejecuta dentro del contenedor) ─────────────
.mvn/wrapper/maven-wrapper.jar

# ── Documentación y colecciones Postman ──────────────────────────
docs/
dev.md
HELP.md
*.postman_collection.json

# ── Tests — se ejecutan en CI antes del despliegue ───────────────
src/test/