# ==================================================================
# .gitignore — raíz del repositorio Ecos-Backend
# El proyecto Spring Boot está en el subdirectorio ecos-backend/
# ==================================================================

# ── Maven (rutas relativas al subdirectorio del proyecto) ─────────
ecos-backend/target/
ecos-backend/.mvn/wrapper/maven-wrapper.jar
ecos-backend/HELP.md
!**/src/main/**/target/
!**/src/test/**/target/

# ── IntelliJ IDEA ─────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr

# ── STS / Eclipse ─────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ── NetBeans ──────────────────────────────────────────────────────
ecos-backend/nbproject/private/
ecos-backend/nbbuild/
ecos-backend/dist/
ecos-backend/nbdist/
ecos-backend/.nb-gradle/
ecos-backend/build/
!**/src/main/**/build/
!**/src/test/**/build/

# ── VS Code ───────────────────────────────────────────────────────
.vscode/

# ── Variables de entorno (NUNCA subir) ────────────────────────────
.env
ecos-backend/.env

# ── Archivos de log ───────────────────────────────────────────────
logs/
*.log

# ── Documentación local de desarrollo (no se sube a Git) ─────────
dev.md
ecos-backend/docs/

# ── Claude Code ───────────────────────────────────────────────────
.claude/