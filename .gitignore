target/
.mvn/wrapper/maven-wrapper.jar
HELP.md
!**/src/main/**/target/
!**/src/test/**/target/

# ── IntelliJ IDEA ─────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr

# ── STS / Eclipse ─────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ── NetBeans ──────────────────────────────────────────────────────
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ── VS Code ───────────────────────────────────────────────────────
.vscode/

# ── Variables de entorno (NUNCA subir) ────────────────────────────
.env

# ── Archivos de log ───────────────────────────────────────────────
logs/
*.log

# ── Documentación local de desarrollo (no se sube a Git) ─────────
dev.md
docs/

# ── Claude Code ───────────────────────────────────────────────────
.claude/