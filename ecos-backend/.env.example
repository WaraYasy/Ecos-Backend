# ==================================================================
# VARIABLES DE ENTORNO — Ecos Backend
# Copia este archivo a .env para desarrollo local.
# En Railway, configúralas en Settings > Variables.
# ==================================================================

# ── Perfil Spring ─────────────────────────────────────────────────
# Railway → prod | Local → dev (ya está en application.properties)
SPRING_PROFILES_ACTIVE=prod

# ── Base de datos ─────────────────────────────────────────────────
# Railway expone DATABASE_URL automáticamente desde el plugin PostgreSQL.
# Formato: postgresql://user:pass@host:port/dbname
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── Spotify API ───────────────────────────────────────────────────
# Obtén estas en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# URI de callback — en Railway: https://tu-app.railway.app/callback/spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback/spotify

# ── Last.fm API ───────────────────────────────────────────────────
# Obtén tu API key en: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_SHARED_SECRET=your_lastfm_shared_secret

# ── TMDB API ──────────────────────────────────────────────────────
# Obtén tu API key en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key
TMDB_API_TOKEN=your_tmdb_bearer_token

# ── Cifrado de tokens OAuth ───────────────────────────────────
# ENCRYPTION_KEY  : contraseña libre, mín. 8 caracteres
# ENCRYPTION_SALT : exactamente 16 caracteres hexadecimales (ej: deadbeefdeadbeef)
ENCRYPTION_KEY=your_encryption_password
ENCRYPTION_SALT=deadbeefdeadbeef

# ── Logs (Better Stack) ───────────────────────────────────────
# Better Stack recibe los logs via Railway Log Drain — sin config extra.
# Setup: betterstack.com → Sources → Add → Railway → copiar drain URL
#        Railway → tu servicio → Settings → Log Drains → pegar URL
