<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================================================================ -->
    <!-- PROPIEDADES COMUNES                                              -->
    <!-- ================================================================ -->

    <property name="LOG_PATH" value="./logs"/>
    <property name="LOG_FILE" value="ecos-backend"/>

    <!-- Patrón legible para consola en desarrollo -->
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%15.15t] %cyan(%-40.40logger{39}) : %msg%n"/>

    <!-- Patrón completo para archivos -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %-40.40logger{39} : %msg%n%ex"/>

    <!-- ================================================================ -->
    <!-- APPENDERS COMPARTIDOS (todos los perfiles)                       -->
    <!-- ================================================================ -->

    <!-- Consola con formato legible (activo en dev) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Archivo general — INFO+ con rotación diaria (dev) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- Archivo de errores — WARN+ (dev) -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${LOG_FILE}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- Consola JSON — definida aquí para que logback la inicie antes     -->
    <!-- de que Spring aplique el perfil, evitando "non started appender" -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"ecos-backend","env":"prod"}</customFields>
            <fieldNames>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <!-- ================================================================ -->
    <!-- LOGGERS ESPECÍFICOS (base, aplica a todos los perfiles)          -->
    <!-- ================================================================ -->

    <logger name="org.springframework"              level="INFO"/>
    <logger name="org.springframework.web"          level="INFO"/>
    <logger name="org.springframework.boot"         level="INFO"/>
    <logger name="org.hibernate"                    level="WARN"/>
    <logger name="org.apache.catalina"              level="WARN"/>
    <logger name="org.apache.tomcat"                level="WARN"/>
    <logger name="com.github.loki4j"                level="WARN"/>

    <!-- Root por defecto (sin perfil activo) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- ================================================================ -->
    <!-- PERFIL DEV                                                        -->
    <!-- ================================================================ -->

    <springProfile name="dev">
        <!-- Más detalle en código propio y SQL -->
        <logger name="es.wara.ecos"                 level="DEBUG"/>
        <logger name="org.hibernate.SQL"            level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql" level="TRACE"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- ================================================================ -->
    <!-- PERFIL PROD                                                       -->
    <!-- ================================================================ -->

    <springProfile name="prod">

        <!-- Better Stack: envía logs directamente desde la app -->
        <appender name="BETTER_STACK" class="com.logtail.logback.LogtailAppender">
            <appName>ecos-backend</appName>
            <sourceToken>${BETTERSTACK_TOKEN}</sourceToken>
            <ingestUrl>${BETTERSTACK_URL}</ingestUrl>
        </appender>

        <!-- Nivel INFO en código propio, sin SQL en prod -->
        <logger name="es.wara.ecos"      level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="BETTER_STACK"/>
        </root>
    </springProfile>

</configuration>
