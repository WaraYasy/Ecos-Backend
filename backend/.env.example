# Copia este archivo a .env y completa con tus credenciales reales
# El archivo .env NO se debe subir a Git (ya está en .gitignore)

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback/spotify

# Last.fm API
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_SHARED_SECRET=your_lastfm_shared_secret_here

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_API_TOKEN=your_tmdb_api_token_here